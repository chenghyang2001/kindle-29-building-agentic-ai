{
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./data"
      ],
      "env": {}
    },
    "deploy": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./mcp-deploy/server.js"
      ],
      "env": {}
    }
  }
}